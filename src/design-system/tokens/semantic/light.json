{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "bg": {
      "canvas": { "$value": "{color.white}" },
      "surface": { "$value": "{color.gray.50}" },
      "surface-raised": { "$value": "{color.white}" },
      "inverse": { "$value": "{color.gray.900}" }
    },
    "text": {
      "primary": { "$value": "{color.gray.900}" },
      "secondary": { "$value": "{color.gray.700}" },
      "muted": { "$value": "{color.gray.600}" },
      "inverse": { "$value": "{color.gray.50}" },
      "on-accent": { "$value": "{color.white}" },
      "on-danger": { "$value": "{color.white}" },
      "link": { "$value": "{color.accent.default}" }
    },
    "border": {
      "default": { "$value": "{color.gray.300}" },
      "strong": { "$value": "{color.gray.600}" },
      "focus": { "$value": "{color.eggplant.600}" }
    },
    "accent": {
      "default": { "$value": "{color.eggplant.600}" },
      "hover": { "$value": "{color.eggplant.700}" },
      "active": { "$value": "{color.eggplant.800}" },
      "subtle": { "$value": "{color.eggplant.50}" }
    },
    "danger": {
      "default": { "$value": "{color.red.600}" },
      "hover": { "$value": "{color.red.700}" },
      "active": { "$value": "{color.red.800}" },
      "subtle": { "$value": "{color.red.50}" }
    }
  }
}
